{
  "name": "coned-battery-wizard",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Browser-only wizard: battery value in Con Edison territory, behind the meter on SC 8 or SC 9 or stand-alone on the Value Stack",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8080",
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs --client",
    "serve:client": "node scripts/build.mjs --client && python3 -m http.server 8080 -d dist",
    "profiles": "node scripts/make_profiles.mjs"
  },
  "license": "UNLICENSED"
}
