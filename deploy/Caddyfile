# The site: HTTPS for {$DOMAIN} (Let's Encrypt), the team login in front of
# everything, /api/* to the API, the rest from the wizard's client build.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# The team login: basic_auth with bcrypt hashes, written by deploy/add-user.sh.
	import /etc/caddy/users.caddy

	handle /api/* {
		reverse_proxy api:3000 {
			# The API records who saved what from this header; only Caddy can reach the API.
			header_up X-Auth-User {http.auth.user.id}
		}
	}

	handle {
		root * /srv
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
