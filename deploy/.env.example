# Copy to deploy/.env and fill in (deploy/.env stays out of git).

# The DNS name pointing at this machine, e.g. wizard.example.com
DOMAIN=wizard.example.com
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=you@example.com
# Database password: generate with  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Only for a local test (e.g. DOMAIN=localhost): other published ports
# HTTP_PORT=8080
# HTTPS_PORT=8443
